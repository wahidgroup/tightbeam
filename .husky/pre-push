#!/usr/bin/env sh
set -e

# Installed via husky-rs (core.hooksPath = .husky).
# Redirect stdin so make/npm cannot consume the ref list git feeds this hook.
if ! make lint </dev/null; then
	echo "ERROR: make lint failed; push aborted."
	exit 1
fi

remote="$1"
z40=0000000000000000000000000000000000000000

# Verify every commit being pushed, excluding only history already on the
# remote default branch (HEAD/main/master) and the old remote tip.
base=""
for ref in "refs/remotes/$remote/HEAD" "refs/remotes/$remote/main" "refs/remotes/$remote/master"; do
	if git rev-parse --verify "$ref" >/dev/null 2>&1; then
		base="$ref"
		break
	fi
done
if [ -z "$base" ]; then
	echo "ERROR: No local tracking ref for $remote default branch (HEAD/main/master)."
	echo "       Run: git fetch $remote"
	echo "       Cannot determine which commits are new without a base."
	exit 1
fi

while read local_ref local_oid remote_ref remote_oid; do
	if [ "$local_oid" = "$z40" ]; then
		continue
	fi

	exclude="$base"
	if [ "$remote_oid" != "$z40" ]; then
		exclude="$exclude $remote_oid"
	fi

	# $exclude is intentionally unquoted: word-split refs/oids for --not.
	for commit in $(git rev-list "$local_oid" --not $exclude); do
		if ! git verify-commit "$commit" 2>/dev/null; then
			echo "ERROR: Commit $commit has an invalid or missing signature."
			echo "       All commits must have a valid signature before pushing."
			exit 1
		fi
	done
done
